PORT=3001
HOST=0.0.0.0
MONGODB_URI=
MONGODB_DB_NAME=nitip

# Firebase Admin: use either GOOGLE_APPLICATION_CREDENTIALS or the three explicit values below.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Active provider for new payment sessions. Existing orders keep the provider they already started with.
# Switch this back to doku at any time to route new payments through DOKU again.
PAYMENT_PROVIDER=doku

# DOKU Checkout. Keep Client ID and Secret Key server-side only.
# Sandbox: https://api-sandbox.doku.com
# Production: https://api.doku.com
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Public HTTPS endpoint registered in DOKU Back Office. The path must match the webhook route below.
# Example: https://api.example.com/payments/doku/notification
DOKU_NOTIFICATION_URL=

# Midtrans Core API. Server Key must remain on the API server and must never be shipped in Expo.
# Sandbox: https://api.sandbox.midtrans.com
# Production: https://api.midtrans.com
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
# Optional for local testing because the app can reconcile status manually/polling.
# For production/public testing use an HTTPS URL, e.g. https://api.example.com/payments/midtrans/notification
MIDTRANS_NOTIFICATION_URL=

# Comma-separated admin account emails.
ADMIN_EMAILS=
