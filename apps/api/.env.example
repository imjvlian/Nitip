HOST=0.0.0.0
PORT=3001

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nitip

# Recommended local Firebase Admin setup.
# Put the downloaded service account JSON at apps/api/secrets/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Optional fallback for environments that cannot mount a service-account JSON file.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Comma-separated Firebase emails allowed to access Nitip Ops.
# Keep this server-side. Example: ops@example.com,owner@example.com
ADMIN_EMAILS=

# Cloudinary signed upload. The API secret must only exist in apps/api/.env / server runtime.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# DOKU Checkout. Keep Client ID and Secret Key on the API/server only.
# Sandbox: https://api-sandbox.doku.com
# Production: https://api.doku.com
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Public HTTPS endpoint that will receive DOKU HTTP Notifications in a later integration step.
DOKU_NOTIFICATION_URL=
