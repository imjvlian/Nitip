{
  "expo": {
    "name": "Nitip Mitra",
    "slug": "nitip-merchant",
    "scheme": "nitip-mitra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nitip Mitra memerlukan akses foto untuk memilih gambar produk.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": { "package": "id.nitip.merchant" },
    "ios": { "bundleIdentifier": "id.nitip.merchant" }
  }
}
