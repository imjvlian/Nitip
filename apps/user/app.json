{
  "expo": {
    "name": "Nitip",
    "slug": "nitip-user",
    "scheme": "nitip",
    "version": "0.12.126",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nitip memerlukan akses foto untuk memilih foto profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nitip memerlukan lokasi untuk menentukan titik alamat pengantaran."
        }
      ]
    ],
    "android": {
      "package": "id.nitip.user"
    },
    "ios": {
      "bundleIdentifier": "id.nitip.user"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
