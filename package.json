{
  "name": "nitip",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:user": "npm run start --workspace @nitip/user",
    "dev:merchant": "npm run start --workspace @nitip/merchant",
    "dev:driver": "npm run start --workspace @nitip/driver",
    "dev:admin": "npm run dev --workspace @nitip/admin",
    "dev:api": "npm run dev --workspace @nitip/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
